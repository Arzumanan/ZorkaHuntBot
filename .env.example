BOT_TOKEN=

# --- Mini App (веб-интерфейс внутри Telegram) ---
# Адрес и порт локального веб-сервера (он запускается вместе с ботом и раздаёт webapp/)
# WEBAPP_HOST=127.0.0.1
# WEBAPP_PORT=8080
# Публичный HTTPS-адрес, по которому Mini App открывается из Telegram:
#   адрес cloudflared (https://xxxx.trycloudflare.com) или GitHub Pages (https://arzumanan.github.io/ZorkaHuntBot/).
# Если не задан, бот отвечает, что приложение не настроено (кнопки запуска не будет).
# WEBAPP_URL=https://example.trycloudflare.com

# --- ВРЕМЕННО: разовый перенос старых данных из zorka.db (удалить после переноса, см. README) ---
# Путь к старой базе. Если файла нет, перенос просто ничего не отдаёт.
# DB_PATH=zorka.db
# Нужно только если приложение открывается НЕ с этого сервера (например, с GitHub Pages): разрешённый Origin для CORS
# WEBAPP_CORS_ORIGIN=https://arzumanan.github.io
