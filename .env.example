BOT_TOKEN=
# Необязательно: путь к файлу базы SQLite
# DB_PATH=zorka.db

# --- Mini App (веб-интерфейс внутри Telegram) ---
# Адрес и порт локального веб-сервера (он запускается вместе с ботом)
# WEBAPP_HOST=127.0.0.1
# WEBAPP_PORT=8080
# Публичный HTTPS-адрес, по которому Mini App открывается из Telegram (например, адрес cloudflared).
# Если не задан, бот работает как раньше, без кнопки Mini App.
# WEBAPP_URL=https://example.trycloudflare.com
# ТОЛЬКО для разработки: id пользователя, от имени которого можно открыть страницу в обычном браузере без Telegram.
# В боевом режиме оставьте пустым!
# WEBAPP_DEV_USER_ID=
# Только если статика лежит на другом домене (например, GitHub Pages): разрешённый Origin для CORS
# WEBAPP_CORS_ORIGIN=
